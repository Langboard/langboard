{
  "schemaVersion": 2,
  "profiles": {
    "socket": {
      "context": "src",
      "dockerfile": "socket/Dockerfile",
      "platform": "linux/amd64",
      "network": "default",
      "buildTarget": "runtime",
      "validation": {
        "target": "validation-results",
        "cachePolicy": "fresh"
      }
    },
    "default": {
      "context": ".",
      "dockerfile": "docker/phoenix-validation.Dockerfile",
      "platform": "linux/amd64",
      "network": "default",
      "buildTarget": "integration-test",
      "integration": {
        "imageTarget": "integration-test",
        "services": [
          "postgres"
        ],
        "timeoutSeconds": 1800,
        "envRefs": {
          "LANGBOARD_FILE_TEST_DATABASE_URL": "postgres.sqlalchemy-url",
          "LANGBOARD_OUTBOX_TEST_DATABASE_URL": "postgres.sqlalchemy-url",
          "LANGBOARD_EFFECT_TEST_DATABASE": "postgres.sqlalchemy-url"
        }
      }
    },
    "api": {
      "context": ".",
      "dockerfile": "Dockerfile",
      "buildTarget": "with-cron",
      "validation": {
        "target": "validation-api",
        "cachePolicy": "fresh"
      },
      "network": "default",
      "platform": "linux/amd64"
    },
    "worker": {
      "context": ".",
      "dockerfile": "Dockerfile",
      "buildTarget": "with-document-processing",
      "validation": {
        "target": "validation-worker",
        "cachePolicy": "fresh"
      },
      "network": "default",
      "platform": "linux/amd64"
    },
    "ui": {
      "context": ".",
      "dockerfile": "docker/ui-production.Dockerfile",
      "buildTarget": "runtime",
      "validation": {
        "target": "validation-ui",
        "cachePolicy": "fresh"
      },
      "network": "default",
      "platform": "linux/amd64"
    }
  }
}
